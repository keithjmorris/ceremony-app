rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone with an (anonymous) session can check a single guest email,
    // but can't list the whole guest collection.
    match /guests/{email} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if false; // add guests via the Firebase Console
    }

    // The shared passcode. Readable so the app can check it client-side —
    // fine for a small trusted guest list, not meant to resist a determined attacker.
    match /config/{docId} {
      allow get: if request.auth != null;
      allow write: if false; // set/change via the Firebase Console
    }

    // Any signed-in guest can browse past recordings.
    match /videos/{videoId} {
      allow read: if request.auth != null;
      allow write: if false; // add entries via the Firebase Console after each broadcast
    }

    // Any signed-in (incl. anonymous) guest can view the album and add photos.
    // Nobody can edit or delete an entry from the app once it's posted.
    match /photos/{photoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.url is string
                    && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
